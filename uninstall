#!/usr/bin/env bash
# Remove pb-suite symlinks from ~/.claude/commands/. Leaves regular files alone.

set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMMANDS_DIR="$REPO_DIR/commands"
TARGET_DIR="${CLAUDE_COMMANDS_DIR:-$HOME/.claude/commands}"

removed=0
left_alone=0

for src in "$COMMANDS_DIR"/pb-*.md "$COMMANDS_DIR"/pb.md; do
  [ -f "$src" ] || continue
  name="$(basename "$src")"
  dst="$TARGET_DIR/$name"

  if [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ]; then
    rm "$dst"
    removed=$((removed + 1))
  elif [ -e "$dst" ]; then
    left_alone=$((left_alone + 1))
  fi
done

BOOTSTRAP_SRC="$REPO_DIR/scripts/lib/bootstrap.sh"
BOOTSTRAP_DST="$TARGET_DIR/pb-bootstrap.sh"
if [ -L "$BOOTSTRAP_DST" ] && [ "$(readlink "$BOOTSTRAP_DST")" = "$BOOTSTRAP_SRC" ]; then
  rm "$BOOTSTRAP_DST"
  removed=$((removed + 1))
elif [ -e "$BOOTSTRAP_DST" ]; then
  left_alone=$((left_alone + 1))
fi

SETTINGS_FILE="${CLAUDE_SETTINGS_FILE:-$HOME/.claude/settings.json}"
GUARD_SRC="$REPO_DIR/hooks/deny-dangerous.sh"

# Remove only our own hook entry, and only when jq is available to do it safely.
# Any other hook the user configured stays untouched.
if [ -f "$SETTINGS_FILE" ] && command -v jq >/dev/null 2>&1; then
  if jq -e --arg cmd "$GUARD_SRC" '[.hooks.PreToolUse[]?.hooks[]?.command] | index($cmd)' "$SETTINGS_FILE" >/dev/null 2>&1; then
    PRUNED=$(jq --arg cmd "$GUARD_SRC" '
      .hooks.PreToolUse = [
        .hooks.PreToolUse[]
        | .hooks = [.hooks[] | select(.command != $cmd)]
        | select(.hooks | length > 0)
      ]
    ' "$SETTINGS_FILE")
    if [ -n "$PRUNED" ]; then
      # Same atomic write as install: never truncate the live file in place.
      printf '%s\n' "$PRUNED" > "$SETTINGS_FILE.tmp.$$"
      mv "$SETTINGS_FILE.tmp.$$" "$SETTINGS_FILE"
      echo "pb-suite: command guard hook removed from $SETTINGS_FILE"
    fi
  fi
fi

echo "pb-suite: removed=$removed left_alone=$left_alone target=$TARGET_DIR"
[ "$left_alone" -gt 0 ] && echo "  (regular files or foreign symlinks were not touched)"
exit 0
