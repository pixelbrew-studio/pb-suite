#!/usr/bin/env bash
# Install pb-suite commands into ~/.claude/commands/ as symlinks pointing to this repo.
# Idempotent. Existing non-symlink files are backed up to <name>.bak.<timestamp>.

set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMMANDS_DIR="$REPO_DIR/commands"
TARGET_DIR="${CLAUDE_COMMANDS_DIR:-$HOME/.claude/commands}"

if [ ! -d "$COMMANDS_DIR" ]; then
  echo "error: $COMMANDS_DIR not found" >&2
  exit 1
fi

mkdir -p "$TARGET_DIR"

stamp="$(date +%Y%m%d%H%M%S)"
linked=0
skipped=0
backed_up=0

for src in "$COMMANDS_DIR"/pb-*.md; do
  [ -f "$src" ] || continue
  name="$(basename "$src")"
  dst="$TARGET_DIR/$name"

  if [ -L "$dst" ]; then
    current="$(readlink "$dst")"
    if [ "$current" = "$src" ]; then
      skipped=$((skipped + 1))
      continue
    fi
    rm "$dst"
  elif [ -e "$dst" ]; then
    mv "$dst" "$dst.bak.$stamp"
    backed_up=$((backed_up + 1))
  fi

  ln -s "$src" "$dst"
  linked=$((linked + 1))
done

BOOTSTRAP_SRC="$REPO_DIR/scripts/lib/bootstrap.sh"
BOOTSTRAP_DST="$TARGET_DIR/pb-bootstrap.sh"
if [ -f "$BOOTSTRAP_SRC" ]; then
  if [ -L "$BOOTSTRAP_DST" ] && [ "$(readlink "$BOOTSTRAP_DST")" = "$BOOTSTRAP_SRC" ]; then
    :
  else
    [ -e "$BOOTSTRAP_DST" ] && rm -f "$BOOTSTRAP_DST"
    ln -s "$BOOTSTRAP_SRC" "$BOOTSTRAP_DST"
  fi
fi

echo "pb-suite: linked=$linked skipped=$skipped backed_up=$backed_up target=$TARGET_DIR"
[ "$backed_up" -gt 0 ] && echo "  backups suffix: .bak.$stamp"

if [ -f "$REPO_DIR/VERSION" ]; then
  CURRENT_VERSION=$(cat "$REPO_DIR/VERSION")
  STATE_FILE="$HOME/.pb-suite-version"
  INSTALLED_VERSION=$(cat "$STATE_FILE" 2>/dev/null || echo "none")
  if [ "$INSTALLED_VERSION" != "$CURRENT_VERSION" ]; then
    echo "pb-suite: version $INSTALLED_VERSION -> $CURRENT_VERSION"
    echo "$CURRENT_VERSION" > "$STATE_FILE"
  fi
fi

if [ -f "$REPO_DIR/package.json" ]; then
  if [ ! -d "$REPO_DIR/node_modules" ]; then
    echo "pb-suite: first-time setup, installing deps (bun install)..."
    (cd "$REPO_DIR" && bun install --silent)
  fi

  if [ ! -d "$HOME/Library/Caches/ms-playwright/chromium-"* ] 2>/dev/null \
    && [ ! -d "$HOME/.cache/ms-playwright/chromium-"* ] 2>/dev/null; then
    echo "pb-suite: installing Chromium for Playwright (~150MB, one-time)..."
    (cd "$REPO_DIR" && bunx playwright install chromium)
  fi
fi

exit 0
