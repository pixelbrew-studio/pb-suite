#!/usr/bin/env bash
# Install pb-suite commands into ~/.claude/commands/ as symlinks pointing to this repo.
# Idempotent. Existing non-symlink files are backed up to <name>.bak.<timestamp>.
#
# --hooks additionally wires the command guard as a PreToolUse hook in
# ~/.claude/settings.json. Opt-in: it is the only part of pb-suite that changes
# how the agent runs rather than what it reads.

set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMMANDS_DIR="$REPO_DIR/commands"
TARGET_DIR="${CLAUDE_COMMANDS_DIR:-$HOME/.claude/commands}"
SETTINGS_FILE="${CLAUDE_SETTINGS_FILE:-$HOME/.claude/settings.json}"

WITH_HOOKS=0
for arg in "$@"; do
  case "$arg" in
    --hooks) WITH_HOOKS=1 ;;
    *) echo "error: unknown argument '$arg' (supported: --hooks)" >&2; exit 1 ;;
  esac
done

if [ ! -d "$COMMANDS_DIR" ]; then
  echo "error: $COMMANDS_DIR not found" >&2
  exit 1
fi

mkdir -p "$TARGET_DIR"

stamp="$(date +%Y%m%d%H%M%S)"
linked=0
skipped=0
backed_up=0

for src in "$COMMANDS_DIR"/pb-*.md "$COMMANDS_DIR"/pb.md; do
  [ -f "$src" ] || continue
  name="$(basename "$src")"
  dst="$TARGET_DIR/$name"

  if [ -L "$dst" ]; then
    current="$(readlink "$dst")"
    if [ "$current" = "$src" ]; then
      skipped=$((skipped + 1))
      continue
    fi
    # Foreign symlink (points elsewhere) — back it up rather than clobber it.
    mv "$dst" "$dst.bak.$stamp"
    backed_up=$((backed_up + 1))
  elif [ -e "$dst" ]; then
    mv "$dst" "$dst.bak.$stamp"
    backed_up=$((backed_up + 1))
  fi

  ln -s "$src" "$dst"
  linked=$((linked + 1))
done

BOOTSTRAP_SRC="$REPO_DIR/scripts/lib/bootstrap.sh"
BOOTSTRAP_DST="$TARGET_DIR/pb-bootstrap.sh"
if [ -f "$BOOTSTRAP_SRC" ]; then
  if [ -L "$BOOTSTRAP_DST" ] && [ "$(readlink "$BOOTSTRAP_DST")" = "$BOOTSTRAP_SRC" ]; then
    :
  else
    { [ -e "$BOOTSTRAP_DST" ] || [ -L "$BOOTSTRAP_DST" ]; } && rm -f "$BOOTSTRAP_DST"
    ln -s "$BOOTSTRAP_SRC" "$BOOTSTRAP_DST"
  fi
fi

if [ "$WITH_HOOKS" -eq 1 ]; then
  GUARD_SRC="$REPO_DIR/hooks/deny-dangerous.sh"
  SETTINGS_DIR="$(dirname "$SETTINGS_FILE")"

  if ! command -v jq >/dev/null 2>&1; then
    echo "error: --hooks needs jq to merge into $SETTINGS_FILE (brew install jq)" >&2
    exit 1
  fi

  mkdir -p "$SETTINGS_DIR"
  chmod +x "$GUARD_SRC"
  [ -f "$SETTINGS_FILE" ] || echo '{}' > "$SETTINGS_FILE"

  # The already-wired test is scoped to the Bash matcher. Checking the command
  # alone would treat the guard attached to some other matcher as installed and
  # silently never wire it to Bash, which is where it has to run.
  MERGED=$(jq --arg cmd "$GUARD_SRC" '
    .hooks //= {} | .hooks.PreToolUse //= []
    | if [.hooks.PreToolUse[]? | select(.matcher == "Bash") | .hooks[]?.command] | index($cmd)
      then .
      else .hooks.PreToolUse += [{matcher: "Bash", hooks: [{type: "command", command: $cmd}]}]
      end
  ' "$SETTINGS_FILE")

  # Only overwrite once jq has produced valid output — a failed merge must not
  # truncate the user's settings.
  if [ -z "$MERGED" ]; then
    echo "error: failed to merge hook into $SETTINGS_FILE (left unchanged)" >&2
    exit 1
  fi

  # settings.json is the user's file and may hold unrelated config, so back it up
  # before writing — but only when the merge actually changes something, so a
  # re-run does not litter the directory with identical backups.
  if [ "$MERGED" != "$(cat "$SETTINGS_FILE")" ]; then
    cp "$SETTINGS_FILE" "$SETTINGS_FILE.bak.$stamp"
    # Write via a temp file and rename, so an interrupted or failed write cannot
    # leave the user with a truncated settings.json.
    printf '%s\n' "$MERGED" > "$SETTINGS_FILE.tmp.$$"
    mv "$SETTINGS_FILE.tmp.$$" "$SETTINGS_FILE"
    echo "pb-suite: command guard wired into $SETTINGS_FILE (backup: $SETTINGS_FILE.bak.$stamp)"
  else
    echo "pb-suite: command guard already wired into $SETTINGS_FILE"
  fi
  echo "  patterns: $REPO_DIR/hooks/dangerous-patterns.txt"
  echo "  Codex is not wired automatically — see the command guard section in README.md."
fi

echo "pb-suite: linked=$linked skipped=$skipped backed_up=$backed_up target=$TARGET_DIR"
[ "$backed_up" -gt 0 ] && echo "  backups suffix: .bak.$stamp"

if [ -f "$REPO_DIR/VERSION" ]; then
  CURRENT_VERSION=$(cat "$REPO_DIR/VERSION")
  STATE_FILE="$HOME/.pb-suite-version"
  INSTALLED_VERSION=$(cat "$STATE_FILE" 2>/dev/null || echo "none")
  if [ "$INSTALLED_VERSION" != "$CURRENT_VERSION" ]; then
    echo "pb-suite: version $INSTALLED_VERSION -> $CURRENT_VERSION"
    echo "$CURRENT_VERSION" > "$STATE_FILE"
  fi
fi

if [ -f "$REPO_DIR/package.json" ]; then
  if [ ! -d "$REPO_DIR/node_modules" ]; then
    echo "pb-suite: first-time setup, installing deps (bun install)..."
    (cd "$REPO_DIR" && bun install --silent)
  fi

  if [ -z "${PB_SKIP_PLAYWRIGHT_BROWSERS:-}" ] \
    && [ ! -d "$HOME/Library/Caches/ms-playwright/chromium-"* ] 2>/dev/null \
    && [ ! -d "$HOME/.cache/ms-playwright/chromium-"* ] 2>/dev/null; then
    echo "pb-suite: installing Chromium for Playwright (~150MB, one-time)..."
    (cd "$REPO_DIR" && bunx playwright install chromium)
  fi
fi

exit 0
